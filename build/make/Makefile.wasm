.PHONY: all check-env renderer-contract-check resource-fs-native-check clean

OUT_DIR ?= browser/dist
TARGET_JS := $(OUT_DIR)/astonia-client.js
TARGET_DATA := $(OUT_DIR)/astonia-client.data
TARGET_WASM := $(OUT_DIR)/astonia-client.wasm

LOCAL_EMSDK_ROOT ?= $(if $(ASTONIA_EMSDK_ROOT),$(ASTONIA_EMSDK_ROOT),$(CURDIR)/.deps/emsdk)
LOCAL_EMCC := $(LOCAL_EMSDK_ROOT)/upstream/emscripten/emcc

EMCC ?= $(if $(wildcard $(LOCAL_EMCC)),$(LOCAL_EMCC),emcc)
HOST_CC ?= clang

SOKOL_DIR := third_party/sokol
WASM_SRCS := \
	src/wasm/sokol_webgpu_harness.c \
	src/wasm/resource_fs_check.c \
	src/wasm/astonia_smoke_observability.c \
	src/wasm/astonia_net_wasm.c \
	src/wasm/sokol_sdl_renderer.c \
	src/render_backend/sokol_webgpu_backend.c \
	src/render_backend/sokol_webgpu_sokol.c
RESOURCE_FILES := $(shell find res -type f | sort)

WASM_JS_LIBS := \
	src/wasm/astonia_net_jslib.js

WASM_CFLAGS := \
	-std=c99 \
	-O2 \
	-Wall \
	-Wextra \
	-Wpedantic \
	-Werror \
	-DNDEBUG \
	-DSOKOL_WGPU \
	-Iinclude \
	-Isrc \
	-isystem $(SOKOL_DIR)

WASM_FLAGS := \
	--preload-file res@/res \
	$(foreach lib,$(WASM_JS_LIBS),--js-library $(lib)) \
	--use-port=emdawnwebgpu \
	-sENVIRONMENT=web \
	-sMODULARIZE=1 \
	-sEXPORT_ES6=1 \
	-sEXPORT_NAME=createAstoniaClientModule \
	-sEXPORTED_FUNCTIONS=_astonia_resource_fs_check,_astonia_resource_fs_expected_count,_astonia_smoke_login_done,_astonia_smoke_sockstate,_astonia_smoke_protocol_version,_astonia_smoke_tick,_astonia_smoke_queued_ticks,_astonia_smoke_queue_size \
	-sALLOW_MEMORY_GROWTH=1 \
	-sMAXIMUM_MEMORY=1GB \
	-sNO_EXIT_RUNTIME=1

all: check-env $(TARGET_JS) $(TARGET_WASM) $(TARGET_DATA)

$(TARGET_JS) $(TARGET_WASM) $(TARGET_DATA) &: $(WASM_SRCS) $(WASM_JS_LIBS) src/wasm/astonia_smoke_observability.h \
		src/render_backend/render_backend.h src/render_backend/sokol_webgpu_backend.h \
		$(SOKOL_DIR)/sokol_app.h $(SOKOL_DIR)/sokol_gfx.h $(SOKOL_DIR)/sokol_glue.h $(SOKOL_DIR)/sokol_log.h \
		$(RESOURCE_FILES)
	@mkdir -p $(OUT_DIR)
	$(EMCC) $(WASM_CFLAGS) $(WASM_SRCS) -o $(TARGET_JS) $(WASM_FLAGS)
	@echo "Built Sokol WebGPU renderer harness: $(TARGET_JS)"
	@echo "Built native WASM module: $(TARGET_WASM)"
	@echo "Packaged native resources for Emscripten FS: $(TARGET_DATA)"

check-env:
	@ASTONIA_EMSDK_ROOT="$(LOCAL_EMSDK_ROOT)" bash scripts/check-wasm-webgpu-env.sh

renderer-contract-check:
	@mkdir -p bin
	$(HOST_CC) -std=c99 -O2 -Wall -Wextra -Wpedantic -Werror -Isrc tests/test_renderer_backend_contract.c \
		-o bin/test_renderer_backend_contract
	@./bin/test_renderer_backend_contract

resource-fs-native-check:
	@mkdir -p bin
	$(HOST_CC) -std=c99 -O2 -Wall -Wextra -Wpedantic -Werror -Isrc -DASTONIA_RESOURCE_FS_CHECK_MAIN \
		src/wasm/resource_fs_check.c -o bin/test_wasm_resource_fs_check
	@./bin/test_wasm_resource_fs_check

clean:
	@rm -rf $(OUT_DIR)
	@mkdir -p $(OUT_DIR)
	@printf '*\n!.gitignore\n' > $(OUT_DIR)/.gitignore
	@rm -f bin/test_renderer_backend_contract bin/test_wasm_resource_fs_check
